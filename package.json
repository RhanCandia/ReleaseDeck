{
  "name": "decky-sidedeck",
  "version": "0.2.0",
  "description": "Download, manage, and update itch.io games, GitHub release packages, and standalone game ports directly in SteamOS Gaming Mode.",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "type-check": "tsc --noEmit",
    "test": "python3 -m unittest discover -s tests -v && python3 tests/e2e_harness.py",
    "package": "bash scripts/package.sh",
    "deploy": "bash scripts/deploy.sh"
  },
  "keywords": [
    "decky",
    "plugin",
    "steam-deck",
    "itch",
    "github",
    "releases",
    "packages",
    "sideload",
    "steamos"
  ],
  "author": "Side Deck Team",
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@rollup/rollup-linux-x64-musl": "^4.53.3",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
